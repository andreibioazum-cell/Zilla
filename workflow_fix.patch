+
+          # NOTE: Diagnostics below must never fail the job.
+          # `run:` blocks execute under `bash -eo pipefail`, so a command piped into
+          # `head` kills the step once `head` stops reading: the producer dies on the
+          # broken pipe and pipefail propagates its status (`ls` -> exit code 2).
+          # Redirect to a file first, then truncate the *file* (no pipe involved).
+          echo "=== APK files ==="
+          find . -name "*.apk" > "$RUNNER_TEMP/apks.txt" 2>&1 || true
+          head -n 100 "$RUNNER_TEMP/apks.txt" || true
+
+          echo "=== editor/build tree (first 500 lines) ==="
+          ls -R editor/build > "$RUNNER_TEMP/editor_build.txt" 2>&1 || true
+          head -n 500 "$RUNNER_TEMP/editor_build.txt" || true
+
+          echo "=== app/build tree (first 200 lines) ==="
+          ls -R app/build > "$RUNNER_TEMP/app_build.txt" 2>&1 || true
+          head -n 200 "$RUNNER_TEMP/app_build.txt" || true
       - name: List outputs
